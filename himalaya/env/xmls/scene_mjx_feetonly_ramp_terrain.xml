<mujoco model="g1 tilted plane scene">
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- Sky is a blue gradient, not white-on-white: without a horizon there is
         no visual reference for the slope angle at all. -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0.1 0.15 0.3" width="800" height="800"/>
    <!-- High-contrast checker so the grade, and motion across it, are obvious. -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.85 0.35 0.15" rgb2="0.95 0.75 0.4"
      markrgb="0.1 0.1 0.1" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- infinite plane: quat overwritten at load from --slope-deg. Unlike an
         hfield, a plane has no finite slab whose edge the robot can land on. -->
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" quat="1 0 0 0"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <key name="knees_bent"
      qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
  </keyframe>
</mujoco>
