<mujoco model="g1 configurable slope track">
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 1.5" extent="5" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <global azimuth="150" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1"
      width="800" height="800"/>
    <texture type="2d" name="track_checker" builtin="checker" mark="edge"
      rgb1="0.78 0.82 0.88" rgb2="0.42 0.48 0.58" markrgb="0.1 0.1 0.1"
      width="300" height="300"/>
    <material name="track_material" texture="track_checker" texuniform="true"
      texrepeat="8 2" reflectance="0"/>
    <hfield name="training_track" nrow="129" ncol="257" size="6 1 5 0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" hfield="training_track"
      material="track_material" friction="0.9 0.9 0.001"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="0 0 0.785 1 0 0 0
      -0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0
      0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0"
      ctrl="-0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0
      0.2 0.2 0 1.28 0 0 0 0.2 -0.2 0 1.28 0 0 0"/>
    <key name="knees_bent"
      qpos="0 0 0.755 1 0 0 0
      -0.312 0 0 0.669 -0.363 0 -0.312 0 0 0.669 -0.363 0 0 0 0.073
      0.2 0.2 0 0.6 0 0 0 0.2 -0.2 0 0.6 0 0 0"
      ctrl="-0.312 0 0 0.669 -0.363 0 -0.312 0 0 0.669 -0.363 0 0 0 0.073
      0.2 0.2 0 0.6 0 0 0 0.2 -0.2 0 0.6 0 0 0"/>
  </keyframe>
</mujoco>
