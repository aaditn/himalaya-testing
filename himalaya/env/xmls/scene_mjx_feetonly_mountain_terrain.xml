<mujoco model="g1 mountainside scene">
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <headlight diffuse="1 1 1" ambient=".55 .55 .55" specular=".3 .3 .3"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- Sky gradient gives a horizon, so the grade has a visual reference. -->
    <texture type="skybox" builtin="gradient" rgb1="0.45 0.60 0.78" rgb2="0.09 0.13 0.26" width="800" height="800"/>
    <!-- Procedural checker rather than rocky_texture.png: an image texture
         carries its own (dark) colour and ignores material rgba, which hid the
         terrain completely. The 5 cm bumps are the whole point of this scene --
         they are what a hand can brace against -- so they must be visible. -->
    <texture type="2d" name="groundplane" builtin="flat"
      rgb1="0.52 0.47 0.43" rgb2="0.34 0.30 0.28" markrgb="0.72 0.69 0.66"
      mark="random" random="0.28" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="14 14" reflectance="0.02" specular="0.15" shininess="0.1"
      rgba="1 1 1 1"/>
    <!-- Mountainside: fractal rock, terraced into ledges. See
         himalaya/env/terrain/make_mountain.py.

         An inclined plane with sharp bumps on it, not a landscape. Mean
         height is ~0.15 m -- the surface is mostly flat, with scattered
         steep-sided bumps 0.10-0.30 m tall. The stock hfield's 5 cm
         undulation is smaller than the 5 cm hand capsule, so a palm rests on
         it and can only press; these bumps are tall and steep enough to
         catch on. The stock hfield is 5 cm of undulation over 7.8 cm
         cells -- a 5 cm hand capsule rests ON that and has nothing to hook, so
         hands could only ever add pressing friction. Here the risers reach
         ~0.2 m, several times the hand radius, so a palm can brace against a
         face instead of just pressing down on one. -->
    <hfield name="hfield" file="assets/mountain.png" size="6 6 2.30 1.0"/>
  </asset>

  <worldbody>
    <!-- No starting platform. It was meant to give a stable start, but zero
         reward on flat ground made it a safe harbour: the policy stood there
         for the whole episode, paying only the loiter rate. Measured at 150M
         steps, progress_uphill summed to -396 over 619 steps, exactly the
         loiter cost per step. Raising the penalty does not help -- it just
         makes sliding the least-bad option instead. The robot now starts on
         the slope itself, with nowhere to retreat to. -->
    <!-- quat is overwritten at load time from --slope-deg; identity here means flat. -->
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane" quat="1 0 0 0"/>
  </worldbody>

  <include file="sensor.xml"/>

  <keyframe>
    <key name="home"
      qpos="
      0 0 0.83
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "
      ctrl="
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
      "/>
    <key name="knees_bent"
      qpos="
      0 0 0.8
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "
      ctrl="
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
    "/>
  </keyframe>
</mujoco>
