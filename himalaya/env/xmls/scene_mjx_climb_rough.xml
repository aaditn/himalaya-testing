<mujoco model="g1 climb rough (heightfield) scene">
  <!-- NOT THE DEFAULT. Kept because geometric purchase is the only way to
       climb a slope steeper than atan(mu), but MuJoCo reports:
         "MULTICCD ... HFIELD/BOX ... At most 1 contact will be generated"
       so each box foot becomes a single point against a heightfield and cannot
       resist tipping. scene_mjx_climb_incline.xml uses a tilted PLANE instead,
       where PLANE/BOX yields four contacts per foot. Revisit this scene if the
       feet are ever replaced by multi-sphere colliders. -->
  <!-- The climbing task: a rough, tiltable slope.
       Control scene: scene_mjx_climb_flat.xml (same hand pairs, flat ground).

       WHY A HEIGHTFIELD AND NOT A TILTED PLANE.
       Sliding is resisted only while mu >= tan(theta): 0.58 at 30 deg, 0.84 at
       40 deg, 1.00 at 45 deg. The domain randomizer draws foot friction below
       1.0 on purpose ("slippery"), so on a SMOOTH ramp at 40-45 deg no policy
       can hold station -- gravity along the slope exceeds what friction can
       return, and the robot slides no matter how good it is. Relief gives the
       hands and feet something to push against, which is how steep slippery
       climbing actually works. The roughness is therefore load-bearing physics,
       not decoration.

       NOTE: <compiler angle="radian"/> comes from g1_mjx_feetonly.xml, so the
       euler below is RADIANS. 0.6109 rad = 35 deg, the midpoint of the
       requested 30-45 deg band. randomize_climb.py rotates the floor per
       environment; this value is only the compile-time default. -->
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.4" extent="1.5" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.7 0.85" rgb2="1 1 1" width="800" height="800"/>
    <!-- https://polyhaven.com/a/rock_face -->
    <texture type="2d" name="groundplane" file="assets/rocky_texture.png"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance=".1"/>
    <!-- size = radius_x radius_y elevation_z base_z. elevation 0.10 gives
         ~10 cm of relief; the walking scene uses 0.05, which is too shallow to
         grip on a steep slope. -->
    <hfield name="hfield" file="assets/hfield.png" size="12 12 0.10 1.0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane" euler="0 -0.6109 0"/>
  </worldbody>

  <!-- See scene_mjx_climb_flat.xml: the G1 sets contype/conaffinity to 0
       globally, so without these explicit pairs the hands pass through the
       ground and climbing on four limbs is physically impossible. Declared per
       scene so the walking task's physics is untouched. -->
  <contact>
    <!-- Legs vs ground. The G1 has thigh/shin collision capsules but the stock
         model gives them no floor pair, so with contype/conaffinity globally 0
         they pass straight through. On flat ground that never shows, because a
         walking policy keeps them clear. In a crawl on rough ground the limbs
         splay and the whole body tunnels into the terrain -- measured 0.73 m of
         "sag" at 30 deg that was really the pelvis sinking below the surface.
         These also make knee contact a real, scorable event. -->
    <pair name="left_thigh_floor" geom1="left_thigh" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="right_thigh_floor" geom1="right_thigh" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="left_shin_floor" geom1="left_shin" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="right_shin_floor" geom1="right_shin" geom2="floor" condim="3" friction="0.6 0.6"/>
  </contact>

  <sensor>
    <contact name="left_shin_floor_found" geom1="left_shin" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_shin_floor_found" geom1="right_shin" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="left_thigh_floor_found" geom1="left_thigh" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_thigh_floor_found" geom1="right_thigh" geom2="floor" reduce="mindist" num="1" data="found"/>
    <framelinvel objtype="site" objname="left_palm" name="left_palm_global_linvel"/>
    <framelinvel objtype="site" objname="right_palm" name="right_palm_global_linvel"/>
  </sensor>

  <include file="sensor.xml"/>

  <keyframe>
    <!-- Four-point stance solved by scripts/find_quadruped_pose.py AT 37.5 deg,
         the midpoint of the 30-45 deg band, under the robot's real +-25 Nm
         shoulder/elbow limits (solved: 11.9 and 3.6 Nm). Solved on the slope,
         not solved flat and rotated: rotating a flat stance leaves the body
         level with the WORLD rather than braced against gravity, which measured
         0.62 m of sag and a 2 m slide. -->
    <key name="home"
      qpos="-0.1361 0.0000 0.2512  0.9896 0.0000 0.1440 0.0000
      -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 0.0000 0.0000 0.2450 -0.2250 0.1500 0.0000 1.1958 0.0000 0.0000 0.0000 -0.2250 -0.1500 0.0000 1.1958 0.0000 0.0000 0.0000"
      ctrl="-0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 0.0000 0.0000 0.2450 -0.2250 0.1500 0.0000 1.1958 0.0000 0.0000 0.0000 -0.2250 -0.1500 0.0000 1.1958 0.0000 0.0000 0.0000"/>
    <!-- The env's _post_init reads "knees_bent" (inherited from the walking
         task, where it is a crouch). For the climb it is the same four-point
         stance: there is no second pose to fall back to. -->
    <key name="knees_bent"
      qpos="-0.1361 0.0000 0.2512  0.9896 0.0000 0.1440 0.0000
      -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 0.0000 0.0000 0.2450 -0.2250 0.1500 0.0000 1.1958 0.0000 0.0000 0.0000 -0.2250 -0.1500 0.0000 1.1958 0.0000 0.0000 0.0000"
      ctrl="-0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 -0.6650 0.0000 0.0000 2.1184 -0.6108 0.0000 0.0000 0.0000 0.2450 -0.2250 0.1500 0.0000 1.1958 0.0000 0.0000 0.0000 -0.2250 -0.1500 0.0000 1.1958 0.0000 0.0000 0.0000"/>
  </keyframe>
</mujoco>
