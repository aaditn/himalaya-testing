<mujoco model="g1 climb flat scene (control)">
  <!-- CONTROL scene for the climbing task: identical to the incline scene in
       every respect EXCEPT the ground is flat and smooth. Its only job is to
       isolate "can the robot hold a four-point stance at all" from "can it do
       so on a steep rough slope". If a result differs between this and
       scene_mjx_climb_incline.xml, the slope is the cause.

       NOTE: <compiler angle="radian"/> is set in g1_mjx_feetonly.xml, so every
       euler here is RADIANS. A "35" would be 35 radians, not 35 degrees. -->
  <include file="g1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.4" extent="1.2" meansize="0.04"/>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="140" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
      markrgb="0 0 0" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
  </worldbody>

  <!-- The G1 model sets contype=0/conaffinity=0 on ALL geoms (global <default
       class="g1">), so contacts come ONLY from explicit <pair> elements. The
       stock model pairs the feet to the floor but not the hands, which means
       the hands fall straight through the ground and quadrupedal locomotion is
       not merely unrewarded, it is impossible.

       These pairs are declared in the climb scenes rather than in
       g1_mjx_feetonly.xml so the walking task's physics stays byte-identical
       and existing walk runs remain comparable. -->
  <contact>
    <!-- Legs vs ground. The G1 has thigh/shin collision capsules but the stock
         model gives them no floor pair, so with contype/conaffinity globally 0
         they pass straight through. On flat ground that never shows, because a
         walking policy keeps them clear. In a crawl on rough ground the limbs
         splay and the whole body tunnels into the terrain -- measured 0.73 m of
         "sag" at 30 deg that was really the pelvis sinking below the surface.
         These also make knee contact a real, scorable event. -->
    <pair name="left_thigh_floor" geom1="left_thigh" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="right_thigh_floor" geom1="right_thigh" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="left_shin_floor" geom1="left_shin" geom2="floor" condim="3" friction="0.6 0.6"/>
    <pair name="right_shin_floor" geom1="right_shin" geom2="floor" condim="3" friction="0.6 0.6"/>
  </contact>

  <sensor>
    <contact name="left_shin_floor_found" geom1="left_shin" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_shin_floor_found" geom1="right_shin" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="left_thigh_floor_found" geom1="left_thigh" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="right_thigh_floor_found" geom1="right_thigh" geom2="floor" reduce="mindist" num="1" data="found"/>
    <framelinvel objtype="site" objname="left_palm" name="left_palm_global_linvel"/>
    <framelinvel objtype="site" objname="right_palm" name="right_palm_global_linvel"/>
  </sensor>

  <include file="sensor.xml"/>

  <keyframe>
    <!-- Four-point stance from scripts/find_quadruped_pose.py, solved AT THIS
         SLOPE under the robot's real +-25 Nm shoulder/elbow limits.
         The COM is biased toward the FEET (15-35% of the way to the hands),
         which is the opposite of the first guess. Measured, null-policy
         episode length at 37.5 deg: 1 step at 55-75% (it pitches straight over
         its hands), 8 steps at 40-60%, 53 at 25-45%, 79 at 15-35%. -->
    <key name="home"
      qpos="0.2158 0.0000 0.4787  0.7640 0.0000 0.6452 0.0000
      -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 0.0000 0.0000 0.2543 -1.9634 0.1500 0.0000 1.2443 0.0000 0.0000 0.0000 -1.9634 -0.1500 0.0000 1.2443 0.0000 0.0000 0.0000"
      ctrl="-2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 0.0000 0.0000 0.2543 -1.9634 0.1500 0.0000 1.2443 0.0000 0.0000 0.0000 -1.9634 -0.1500 0.0000 1.2443 0.0000 0.0000 0.0000"/>
    <key name="knees_bent"
      qpos="0.2158 0.0000 0.4787  0.7640 0.0000 0.6452 0.0000
      -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 0.0000 0.0000 0.2543 -1.9634 0.1500 0.0000 1.2443 0.0000 0.0000 0.0000 -1.9634 -0.1500 0.0000 1.2443 0.0000 0.0000 0.0000"
      ctrl="-2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 -2.2872 0.0000 0.0000 1.7805 -0.8480 0.0000 0.0000 0.0000 0.2543 -1.9634 0.1500 0.0000 1.2443 0.0000 0.0000 0.0000 -1.9634 -0.1500 0.0000 1.2443 0.0000 0.0000 0.0000"/>
  </keyframe>
</mujoco>
